# ============================================
# WVP Docker 部署配置
# 修改后执行 docker compose up -d (或 restart) 生效
# ============================================

# ============ 镜像 ============
# 镜像名 = ${DOCKER_HUB_USER}/wvp-gb28181-pro:${VERSION}
# 本地构建/推送镜像时在 shell 中 export DOCKER_HUB_USER=你的dockerhub用户名
DOCKER_HUB_USER=wvp
VERSION=2.7.4

# ============ WVP ============
# Web界面与API端口
WVP_HTTP_PORT=18978
# [可选] Java内存参数
#JAVA_OPTS=-Xms512m -Xmx1024m

# ============ [必须修改] 流媒体IP ============
# 客户端播放流时访问ZLM使用的IP: 局域网部署填宿主机内网IP, 公网部署填公网IP
STREAM_IP=127.0.0.1
# 设备向服务器推流时使用的IP, 一般与STREAM_IP相同
SDP_IP=127.0.0.1

# ============ GB28181 信令 ============
# [可选] 前端展示用的IP
SIP_ShowIP=127.0.0.1
SIP_Port=8116
# 国标编码(参照GB/T 2260-2007), 按实际部署区域修改
SIP_Domain=3502000000
# 服务器20位国标编码, 后2位行业编码
SIP_Id=35020000002000000001
# 设备注册密码
SIP_Password=wvp_sip_password

# ============ ZLM ============
# [必须与 media/config.ini 中 api.secret 一致]
ZLM_SECRET=su6TiedN2rVAmBbIDX0aa0QTiBJLBdcf
# ZLM端口映射(宿主机端口), 冲突时修改
ZLM_HTTP=8080
ZLM_HTTPS=8443
ZLM_RTMP=1935
ZLM_RTSP=8554
ZLM_RTP=10000
ZLM_RTC=8000
ZLM_SRT=9000
# RTP多端口范围(需在防火墙/云安全组放行整个范围)
RTP_RANGE_START=30000
RTP_RANGE_END=30500

# ============ 录像 ============
RecordSip=false
RecordPushLive=false
