# WVP HTTP 端口（容器内外一致）
WVP_HTTP_PORT=18978

# SIP 监听端口
SIP_Port=8116
# 设备看到的 SIP 服务器 IP，外部访问时改成本机对外 IP
SIP_ShowIP=127.0.0.1
SIP_Domain=3502000000
SIP_Id=35020000002000000001
SIP_Password=wvp_sip_password

# 播流地址与 SDP 中使用的 IP，外部访问时改成本机对外 IP
Stream_IP=127.0.0.1
SDP_IP=127.0.0.1

# ZLM 收流端口，需与 docker/media/config.ini 中的 port 一致
MediaRtmp=10001
MediaRtsp=10004
MediaRtp=10003

# RTP 收流模式：false 即单端口（ssrc 区分每路流），true 即多端口（端口区分）
RTP_ENABLE=false
# 收流端口范围，仅多端口模式使用
RTP_RANGE_START=30000
RTP_RANGE_END=30500
# 级链发送端口范围，需与 docker/media/config.ini 的 [rtp_proxy] port_range 一致
RTP_SEND_RANGE_START=40001
RTP_SEND_RANGE_END=40500

# ZLM 的 hook.admin_params=secret，需与 config.ini 一致
ZLM_SECRET=su6TiedN2rVAmBbIDX0aa0QTiBJLBdcf

RecordSip=true
RecordPushLive=true
